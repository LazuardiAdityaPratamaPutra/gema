{
  "name": "gema",
  "version": "1.2.0",
  "private": true,
  "description": "Gema — Suaramu tidak hilang. Brankas, Jembatan, dan Jam Akuntabilitas untuk penanganan kekerasan seksual di perguruan tinggi.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:verifier && npm run build:ort && next build",
    "build:verifier": "node scripts/build-verifier.mjs",
    "build:ort": "node scripts/copy-ort.mjs",
    "predev": "npm run build:verifier && npm run build:ort",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/styles/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run format:check && npm test",
    "seed": "node scripts/seed-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "^5.6.0",
    "vitest": "5.1.1"
  }
}
